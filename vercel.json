{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [{ "source": "/u/:user/:year", "destination": "/api/share?user=:user&year=:year" }],
  "functions": {
    "api/share.ts": { "includeFiles": "dist/index.html" }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
