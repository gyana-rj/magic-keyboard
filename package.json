{
  "name": "commit-symphony",
  "version": "0.1.0",
  "description": "Turn a GitHub user's yearly contribution graph into a ~30-second song with a synced visual.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
