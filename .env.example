# Server-side only. Never prefix with VITE_ (that would ship it to the browser).
# Fine-grained token (public data, no extra permissions) or classic token with no scopes.
# Leave unset in dev to use fixtures.
GITHUB_TOKEN=

# Optional: your canonical origin, used in share links and link-preview tags (path is ignored).
# Defaults to the request's origin.
PUBLIC_URL=
